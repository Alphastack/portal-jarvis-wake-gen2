<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:padding="20dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<Switch android:id="@+id/enabled" android:text="Enable wake listening" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/phrase" android:hint="Wake phrase (e.g. hey jarvis)" android:layout_width="match_parent" android:layout_height="wrap_content"/><Switch android:id="@+id/screen_off" android:text="Listen while screen is off (uses battery)" android:layout_width="match_parent" android:layout_height="wrap_content"/><Switch android:id="@+id/autostart" android:text="Start after reboot" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Sensitivity: keyword 0.80, remaining words 0.60" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/retry" android:text="Download/retry model" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/test" android:text="Test handoff" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="Status: idle" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Version 1.0.0 • Diagnostics: adb logcat -s PortalJarvisWake\nJarvis may remain visible after handoff." android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout></ScrollView>
